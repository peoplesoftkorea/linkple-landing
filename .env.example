# 미션7 백엔드 — 이 파일을 .env 로 복사해 값을 채웁니다.
# ⚠️ .env 자체는 깃에 올리지 않습니다. 저장소에 올라간 비밀은 더 이상 비밀이 아닙니다.

# 데이터베이스 (로컬 개발)
DATABASE_URL="postgresql://apple@localhost:5432/linkple_mission7"

# 토큰 서명 키. 운영에서는 반드시 다른 값으로 바꿉니다.
JWT_SECRET="dev-only-change-in-production"
JWT_EXPIRES_IN="2h"

NODE_ENV="development"

# 프론트가 부를 API 주소.
#  - 비우면 같은 오리진의 /api 를 씁니다 (배포 기본값)
#  - 로컬에서 `npm run api` 로 서버를 따로 띄웠다면 아래를 켭니다
# VITE_API_BASE_URL="http://localhost:3001"
