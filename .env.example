# 미션7 백엔드 — 이 파일을 .env 로 복사해 값을 채웁니다.
# ⚠️ .env 자체는 깃에 올리지 않습니다. 저장소에 올라간 비밀은 더 이상 비밀이 아닙니다.

# 데이터베이스 (로컬 개발)
DATABASE_URL="postgresql://apple@localhost:5432/linkple_mission7"

# 토큰 서명 키. 운영에서는 반드시 다른 값으로 바꿉니다.
JWT_SECRET="dev-only-change-in-production"
JWT_EXPIRES_IN="2h"

NODE_ENV="development"

# 프론트가 부를 API 주소.
#  - 비우면 같은 오리진의 /api 를 씁니다 (배포 기본값)
#  - 로컬에서 `npm run api` 로 서버를 따로 띄웠다면 아래를 켭니다
# VITE_API_BASE_URL="http://localhost:3001"

# 미션8 — AI 공고문 초안 (서버 전용 키. 브라우저에 절대 싣지 않는다)
OPENAI_API_KEY=""

# ── 미션 9-1 계측 ────────────────────────────────────────────────────────────
# ⚠️ 이 앱 «전용» 값을 넣습니다. 다른 서비스의 GA4 속성·Amplitude 프로젝트를 재사용하면
#    두 서비스의 데이터가 한 곳에 섞여 어느 쪽 수치인지 가릴 수 없게 됩니다.
# 값이 없으면 전송하지 않고 콘솔·window.__LOG_QA 에만 남습니다(조용히 실패하지 않습니다).
VITE_AMPLITUDE_API_KEY=""
VITE_GA4_MEASUREMENT_ID=""
# 배포본에서도 콘솔 로그를 보려면 "1" (로그 QA 증빙 촬영용)
VITE_TRACK_DEBUG=""
